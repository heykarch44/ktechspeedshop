---
import Base from "../../layouts/Base.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
---

<Base
  title="Checkout"
  description="Checkout for K-TECH Speedshop merch."
  noindex={true}
>
  <Header />
  <main id="main" class="wrap page-hero checkout-page">
    <span class="kicker">Merch</span>
    <h1>Checkout</h1>
    <div data-merch-mount="checkout"></div>
  </main>
  <Footer />
</Base>

<style>
  .checkout-page {
    max-width: 52rem;
  }
</style>
