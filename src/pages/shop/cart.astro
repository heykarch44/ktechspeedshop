---
import Base from "../../layouts/Base.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
---

<Base
  title="Cart"
  description="Your K-TECH Speedshop merch cart."
  noindex={true}
>
  <Header />
  <main id="main" class="wrap page-hero">
    <span class="kicker">Merch</span>
    <h1>Cart</h1>
    <div data-merch-mount="cart" class="cart-root"></div>
  </main>
  <Footer />
</Base>

<style>
  .cart-root {
    margin-top: 1.6rem;
    max-width: 42rem;
  }
</style>
