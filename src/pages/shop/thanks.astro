---
import Base from "../../layouts/Base.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
---

<Base
  title="Thanks"
  description="Thanks for your K-TECH Speedshop merch order."
  noindex={true}
>
  <Header />
  <main id="main" class="wrap page-hero">
    <span class="kicker">Merch</span>
    <div id="thanks-root">
      <h1>Checking payment…</h1>
      <p class="lede">One moment.</p>
    </div>
  </main>
  <Footer />
</Base>

<style>
  .order-summary {
    margin-top: 1.2rem;
    color: var(--paper-dim);
    max-width: 28rem;
  }
  .order-summary p {
    margin: 0.35rem 0;
  }
</style>

<script is:inline>
  (function () {
    var root = document.getElementById("thanks-root");
    if (!root) return;

    function money(cents) {
      if (cents == null) return "—";
      return new Intl.NumberFormat("en-US", { style: "currency", currency: "USD" }).format(
        cents / 100,
      );
    }

    var params = new URLSearchParams(window.location.search);
    var sessionId = (params.get("session_id") || "").trim();
    if (!sessionId) {
      root.innerHTML =
        '<h1>Payment not completed</h1><p class="lede">No checkout session was found.</p><p><a class="btn rust" href="/shop/checkout">Back to checkout</a></p>';
      return;
    }

    fetch("/api/session-status?session_id=" + encodeURIComponent(sessionId))
      .then(function (res) {
        return res.json().then(function (data) {
          return { res: res, data: data };
        });
      })
      .then(function (_ref) {
        var res = _ref.res;
        var data = _ref.data;
        if (!res.ok || !data.ok) {
          root.innerHTML =
            '<h1>Could not confirm payment</h1><p class="lede">' +
            (data.error || "Try again from checkout.") +
            '</p><p><a class="btn rust" href="/shop/checkout">Back to checkout</a></p>';
          return;
        }

        if (data.status === "complete" || data.payment_status === "paid") {
          if (window.KtechCart) window.KtechCart.clear();
          root.innerHTML =
            "<h1>Order confirmed</h1>" +
            '<p class="lede">Thanks' +
            (data.customer_name ? ", " + data.customer_name : "") +
            ". We emailed " +
            (data.customer_email || "you") +
            " a receipt when mail is connected.</p>" +
            '<div class="order-summary">' +
            "<p>Subtotal " +
            money(data.amount_subtotal) +
            "</p>" +
            "<p>Shipping " +
            money(data.shipping_cents) +
            "</p>" +
            "<p><strong>Total " +
            money(data.amount_total) +
            "</strong></p>" +
            "</div>" +
            '<p style="margin-top:1.4rem"><a class="btn rust" href="/shop">Back to shop</a></p>';
          return;
        }

        if (data.status === "open") {
          root.innerHTML =
            '<h1>Payment not completed</h1><p class="lede">Your checkout session is still open.</p><p><a class="btn rust" href="/shop/checkout">Back to checkout</a></p>';
          return;
        }

        root.innerHTML =
          "<h1>Payment status: " +
          (data.status || "unknown") +
          '</h1><p class="lede">If you were charged, email shop@ktechspeedshop.com with your receipt.</p><p><a class="btn ghost" href="/shop">Back to shop</a></p>';
      })
      .catch(function () {
        root.innerHTML =
          '<h1>Could not confirm payment</h1><p class="lede">Network error. Try again.</p><p><a class="btn rust" href="/shop/checkout">Back to checkout</a></p>';
      });
  })();
</script>
