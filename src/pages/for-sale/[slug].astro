---
import Base from "../../layouts/Base.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { listings, getListing } from "../../data/catalog";
import { site } from "../../data/site";

export function getStaticPaths() {
  return listings.map((item) => ({ params: { slug: item.slug } }));
}

const item = getListing(Astro.params.slug!);
if (!item) throw new Error("Missing listing");
---

<Base title={`${item.title} for sale`} description={item.summary} image={item.cover}>
  <Header />
  <main id="main">
    <section class="hero" style="min-height:72svh">
      <img src={item.cover} alt={item.title} width="2400" height="1350" />
      <div class="hero-copy">
        <span class="kicker">{item.eyebrow ?? `${item.year} · ${item.status}`}</span>
        <h1>{item.title}</h1>
        <p>{item.summary}</p>
        <p class:list={["price", { ghost: item.ghostPrice }]} style="font-size:1.4rem">{item.price}</p>
      </div>
    </section>
    <section class="section">
      <div class="wrap split">
        <div>
          <h2>The truck.</h2>
          <p class="lede">{item.details}</p>
          <div class="btn-row" style="margin-top:1.3rem">
            {item.status === "sold" ? (
              <a class="btn ghost" href="/builds">See other builds</a>
            ) : (
              <>
                <a class="btn rust" href={`mailto:${site.email}?subject=${encodeURIComponent("For sale: " + item.title)}`}>Email to inquire</a>
                <a class="btn ghost" href={site.instagramUrl}>Instagram DM</a>
              </>
            )}
          </div>
        </div>
        <ul class="spec-list">
          {item.highlights.map((line) => <li>{line}</li>)}
        </ul>
      </div>
    </section>
  </main>
  <Footer />
</Base>
