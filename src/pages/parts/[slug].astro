---
import Base from "../../layouts/Base.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { parts, getPart } from "../../data/catalog";
import { site } from "../../data/site";

export function getStaticPaths() {
  return parts.map((item) => ({ params: { slug: item.slug } }));
}

const item = getPart(Astro.params.slug!);
if (!item) throw new Error("Missing part");
---

<Base title={item.title} description={item.summary} image={item.cover}>
  <Header />
  <main id="main" class="wrap page-hero">
    <div class="split">
      <img src={item.cover} alt={item.title} width="1200" height="1200" />
      <div>
        <span class="kicker">{item.fits}</span>
        <h1 style="font-size:clamp(2.4rem,6vw,4.2rem)">{item.title}</h1>
        <p class="price" style="font-size:1.4rem;margin:0.8rem 0">{item.price}</p>
        <p class="lede">{item.details}</p>
        <div class="btn-row" style="margin-top:1.3rem">
          <a class="btn rust" href={`mailto:${site.email}?subject=${encodeURIComponent("Order: " + item.title)}`}>Email to order</a>
          <a class="btn ghost" href={site.instagramUrl}>Order on Instagram</a>
        </div>
      </div>
    </div>
  </main>
  <Footer />
</Base>
