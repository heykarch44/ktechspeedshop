---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Card from "../components/Card.astro";
import { site } from "../data/site";
import { builds, listings, merch, parts } from "../data/catalog";
import { getUpdates } from "../lib/projects";
import { formatDate } from "../lib/format";

const featured = builds.filter((b) => b.featured).slice(0, 3);
const latestUpdates = (await getUpdates()).slice(0, 3);
---

<Base
  title="K-TECH Speedshop | Custom C10 Builds, Parts & Merch"
  description="K-TECH Speedshop builds custom Chevrolet C10 trucks and C10 parts. See completed builds, projects for sale, shop merch, and start a restomod."
  image="/images/builds/hero-c10.png"
>
  <Header />
  <main id="main">
    <section class="hero">
      <img
        src="/images/builds/hero-c10.png"
        alt="Custom slammed black 1968 Chevrolet C10 shortbed built by K-TECH Speedshop"
        width="2400"
        height="1350"
        fetchpriority="high"
      />
      <div class="hero-copy">
        <span class="kicker">K-TECH Speedshop</span>
        <h1>C10s built to drive.</h1>
        <p>
          Custom Chevrolet C10 builds, shop-made parts, and the occasional truck for sale.
          1967–1987.
        </p>
        <div class="btn-row">
          <a class="btn rust" href="/builds">See the builds</a>
          <a class="btn ghost" href="/projects">Follow a project</a>
          <a class="btn ghost" href={site.instagramUrl} rel="noopener noreferrer">Instagram</a>
        </div>
      </div>
    </section>

    <div class="ticker" aria-hidden="true">
      <div class="ticker-track">
        {
          Array.from({ length: 2 }).map(() => (
            <span>
              67–72 C10 · 73–87 Squarebody · LS swaps · Air ride · Chassis · Paint · Custom parts · Merch ·
            </span>
          ))
        }
      </div>
    </div>

    <section class="section">
      <div class="wrap">
        <div class="section-head">
          <div>
            <span class="kicker">Builds</span>
            <h2>What left the bay.</h2>
          </div>
          <a class="btn ghost" href="/builds">All builds</a>
        </div>
        <div class="photo-grid">
          {
            featured.map((build) => (
              <Card
                href={`/builds/${build.slug}`}
                image={build.cover}
                eyebrow={`${build.year} · ${build.status.replace("-", " ")}`}
                title={build.title}
                alt={`${build.year} Chevrolet ${build.model} custom C10 build ${build.nickname}`}
              />
            ))
          }
        </div>
      </div>
    </section>

    <section class="section" style="padding-top:0">
      <div class="wrap">
        <div class="section-head">
          <div>
            <span class="kicker">Projects</span>
            <h2>Dated entries as they happen.</h2>
          </div>
          <a class="btn ghost" href="/projects">All project logs</a>
        </div>
        <div class="journal-list">
          {
            latestUpdates.map((update) => (
              <a class="journal-item" href={`/projects/${update.data.project}/${update.id}`}>
                {update.data.images[0] && (
                  <img src={update.data.images[0]} alt="" width="560" height="380" loading="lazy" />
                )}
                <div>
                  <span class="kicker">{formatDate(update.data.pubDate)}</span>
                  <h3 style="font-family:var(--font-display);text-transform:uppercase;letter-spacing:0.06em;font-size:1.6rem;margin:0.3rem 0 0.45rem">
                    {update.data.title}
                  </h3>
                  <p style="color:var(--paper-dim);margin:0">{update.data.summary}</p>
                </div>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <section class="section" style="padding-top:0">
      <div class="wrap split">
        <img
          src="/images/builds/engine-bay-ls.png"
          alt="Custom LS-swapped Chevrolet C10 engine bay fabricated at K-TECH Speedshop"
          width="1600"
          height="1200"
          loading="lazy"
        />
        <div>
          <span class="kicker">The work</span>
          <h2>Parts you can buy. Trucks you can commission.</h2>
          <p class="lede">
            Most C10 sites are a parts dump with a blurry photo of a truck in a parking lot.
            We lead with the builds, sell the hardware we actually run, and keep a couple of
            projects on the market.
          </p>
          <div class="btn-row" style="margin-top:1.4rem">
            <a class="btn rust" href="/parts">Shop C10 parts</a>
            <a class="btn ghost" href="/contact">Start a build</a>
          </div>
        </div>
      </div>
    </section>

    <section class="section" style="background:var(--bg-2)">
      <div class="wrap">
        <div class="section-head">
          <div>
            <span class="kicker">For sale</span>
            <h2>Projects on the market.</h2>
          </div>
          <a class="btn ghost" href="/for-sale">See inventory</a>
        </div>
        <div class="photo-grid">
          {
            listings.map((item) => (
              <Card
                href={`/for-sale/${item.slug}`}
                image={item.cover}
                eyebrow={`${item.year} · ${item.price}`}
                title={item.title}
                alt={`${item.year} Chevrolet ${item.model} C10 for sale at K-TECH Speedshop`}
              />
            ))
          }
        </div>
      </div>
    </section>

    <section class="section">
      <div class="wrap">
        <div class="section-head">
          <div>
            <span class="kicker">Shop</span>
            <h2>Hats, shirts, the uniform.</h2>
          </div>
          <a class="btn ghost" href="/shop">All merch</a>
        </div>
        <div class="product-grid">
          {
            merch.map((item) => (
              <a class="product" href="/shop">
                <img src={item.cover} alt={`${item.title} from K-TECH Speedshop`} width="800" height="800" loading="lazy" />
                <div class="product-body">
                  <h3>{item.title}</h3>
                  <p>{item.summary}</p>
                  <span class="price">{item.price}</span>
                </div>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <section class="section" style="padding-top:0">
      <div class="wrap">
        <div class="section-head">
          <div>
            <span class="kicker">Parts</span>
            <h2>Hardware from the same bench.</h2>
          </div>
          <a class="btn ghost" href="/parts">All parts</a>
        </div>
        <div class="product-grid">
          {
            parts.slice(0, 3).map((item) => (
              <a class="product" href={`/parts/${item.slug}`}>
                <img src={item.cover} alt={`${item.title} for Chevrolet C10`} width="800" height="800" loading="lazy" />
                <div class="product-body">
                  <h3>{item.title}</h3>
                  <p>{item.fits}</p>
                  <span class="price">{item.price}</span>
                </div>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <section class="ig-band">
      <img
        src="/images/shop/garage.jpg"
        alt="K-TECH Speedshop garage floor during a C10 build"
        width="1600"
        height="1000"
        loading="lazy"
      />
      <div>
        <span class="kicker">Follow the shop</span>
        <h2>{site.instagramHandle}</h2>
        <p class="lede">
          In-progress metal, finished trucks, parts on the mill, and whatever is for sale this week.
          Instagram is the live feed. This site is the record.
        </p>
        <div class="btn-row" style="margin-top:1.2rem">
          <a class="btn rust" href={site.instagramUrl} rel="noopener noreferrer">Open Instagram</a>
          <a class="btn ghost" href="/contact">Email the shop</a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Base>
