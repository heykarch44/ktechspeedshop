---
import Base from "../../layouts/Base.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("journal");
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Base
  title={post.data.title}
  description={post.data.description}
  image={post.data.image}
  type="article"
>
  <Header />
  <main id="main">
    <section class="hero" style="min-height:56svh">
      <img src={post.data.image} alt="" width="2400" height="1200" />
      <div class="hero-copy">
        <span class="kicker">Journal · {post.data.pubDate.toISOString().slice(0, 10)}</span>
        <h1 style="font-size:clamp(2.6rem,7vw,5rem)">{post.data.title}</h1>
      </div>
    </section>
    <article class="section">
      <div class="wrap prose">
        <Content />
        <p>
          Ready to talk about a truck? <a href="/contact">Send a build inquiry</a>.
        </p>
      </div>
    </article>
  </main>
  <Footer />
</Base>
