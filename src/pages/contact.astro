---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { site } from "../data/site";
---

<Base
  title="Start a C10 Build"
  description="Contact K-TECH Speedshop about a custom Chevrolet C10 build, a project for sale, C10 parts, or merch. Instagram DMs and email."
>
  <Header />
  <main id="main" class="wrap page-hero">
    <span class="kicker">Contact</span>
    <h1>Start here.</h1>
    <p class="lede">
      Builds, parts, merch, trucks for sale. Instagram is fastest. Email if you have photos
      of a truck you want us to look at.
    </p>
    <p>
      <a class="btn rust" href={site.instagramUrl}>{site.instagramHandle}</a>
      <a class="btn ghost" href={`mailto:${site.email}`}>{site.email}</a>
    </p>
    <form class="form" style="margin-top:2rem" method="post" action={`mailto:${site.email}`} enctype="text/plain">
      <label>
        Name
        <input type="text" name="name" required autocomplete="name" />
      </label>
      <label>
        Email
        <input type="email" name="email" required autocomplete="email" />
      </label>
      <label>
        What is this about
        <select name="topic">
          <option>Custom C10 build</option>
          <option>Truck for sale</option>
          <option>Parts order</option>
          <option>Merch</option>
          <option>Something else</option>
        </select>
      </label>
      <label>
        Year / cab / bed / what you want
        <textarea name="message" required placeholder="67–72 shortbed, LS, bags, driver. Photos help."></textarea>
      </label>
      <button class="btn rust" type="submit">Open email draft</button>
    </form>
  </main>
  <Footer />
</Base>
