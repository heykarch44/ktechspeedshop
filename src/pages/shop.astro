---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { merch } from "../data/catalog";
import { site } from "../data/site";
---

<Base
  title="K-TECH Speedshop Merch"
  description="K-TECH Speedshop hats, tees, hoodies, and K_tech merch. Add to cart and checkout on-site. Sizes ship from the shop."
  image="/images/merch/trucker-print.png"
>
  <Header />
  <main id="main" class="wrap page-hero">
    <div class="shop-head">
      <div>
        <span class="kicker">Merch</span>
        <h1>The uniform.</h1>
        <p class="lede">
          Hats, tees, hoodies. Pick a size, add to cart, check out here. When a drop is gone, it is gone.
        </p>
      </div>
      <a class="btn ghost" href="/shop/cart/">View cart</a>
    </div>
    <div class="product-grid" style="margin-top:2.2rem">
      {
        merch.map((item) => {
          const oneSize = item.sizes.length === 1;
          return (
            <article class="product" data-merch-slug={item.slug}>
              <img
                src={item.cover}
                alt={`${item.title} K-TECH Speedshop merch`}
                width="800"
                height="800"
                loading="lazy"
              />
              <div class="product-body">
                <h3>{item.title}</h3>
                <p>{item.summary}</p>
                <p class="fine">{oneSize ? item.sizes[0] : item.sizes.join(" · ")}</p>
                <p class="price">{item.price}</p>
                <form class="merch-add" data-add-form>
                  <input type="hidden" name="slug" value={item.slug} />
                  {!oneSize ? (
                    <label class="merch-field">
                      <span>Size</span>
                      <select name="size" required>
                        {item.sizes.map((size) => (
                          <option value={size}>{size}</option>
                        ))}
                      </select>
                    </label>
                  ) : (
                    <>
                      <input type="hidden" name="size" value={item.sizes[0]} />
                      <label class="merch-field">
                        <span>Size</span>
                        <span class="merch-size-static">{item.sizes[0]}</span>
                      </label>
                    </>
                  )}
                  <label class="merch-field">
                    <span>Qty</span>
                    <input type="number" name="qty" min="1" max="99" value="1" required />
                  </label>
                  <button class="btn rust" type="submit">Add to cart</button>
                </form>
                <p class="add-msg" data-add-msg aria-live="polite" hidden></p>
              </div>
            </article>
          );
        })
      }
    </div>
    <p class="fine" style="margin-top:2rem">
      Questions?{" "}
      <a href={`mailto:${site.email}?subject=${encodeURIComponent("Merch question")}`}>Email</a>
      {" "}or{" "}
      <a href={site.instagramUrl}>DM</a>.
    </p>
  </main>
  <a class="shop-cart-pill" href="/shop/cart/" data-shop-cart-pill hidden>
    Cart (<span data-shop-cart-count>0</span>) →
  </a>
  <Footer />
</Base>

<style>
  .shop-head {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 1.5rem;
    flex-wrap: wrap;
  }
  .merch-add {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    align-items: end;
    margin-top: auto;
    padding-top: 0.8rem;
  }
  .merch-field {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    font-size: 0.78rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-family: var(--font-display);
    color: var(--paper-dim);
  }
  .merch-field select,
  .merch-field input,
  .merch-size-static {
    min-height: 2.6rem;
    min-width: 4.5rem;
    padding: 0.4rem 0.55rem;
    background: var(--bg-2);
    border: 1px solid var(--line);
    color: var(--paper);
    box-sizing: border-box;
  }
  .merch-size-static {
    display: inline-flex;
    align-items: center;
    font-family: inherit;
    font-size: 1rem;
    letter-spacing: normal;
    text-transform: none;
  }
  .fine {
    color: var(--muted);
    font-size: 0.92rem;
  }
  .fine a {
    color: var(--paper-dim);
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }
  .add-msg {
    color: #d3541a;
    font-size: 0.92rem;
    margin: 0.55rem 0 0;
  }
  .add-msg a {
    color: #d3541a;
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }
  .shop-cart-pill {
    position: fixed;
    right: max(1rem, env(safe-area-inset-right));
    bottom: max(1rem, env(safe-area-inset-bottom));
    z-index: 35;
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.65rem 0.95rem;
    background: var(--rust);
    color: var(--bg);
    font-family: var(--font-display);
    font-size: 0.78rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
    border: 1px solid color-mix(in srgb, var(--rust) 70%, #000);
    box-shadow: 0 8px 24px color-mix(in srgb, #000 45%, transparent);
  }
  .shop-cart-pill[hidden] {
    display: none;
  }
</style>

<script is:inline>
  (function () {
    var cartScriptPromise = null;

    function ensureCart() {
      if (window.KtechCart) return Promise.resolve(window.KtechCart);
      if (cartScriptPromise) return cartScriptPromise;
      cartScriptPromise = new Promise(function (resolve, reject) {
        var s = document.createElement("script");
        s.src = "/js/ktech-cart.js";
        s.onload = function () {
          if (window.KtechCart) resolve(window.KtechCart);
          else reject(new Error("KtechCart missing"));
        };
        s.onerror = function () {
          reject(new Error("Failed to load cart"));
        };
        document.head.appendChild(s);
      });
      return cartScriptPromise;
    }

    function showMsg(msg, ok) {
      if (!msg) return;
      msg.hidden = false;
      msg.replaceChildren();
      if (!ok) {
        msg.textContent =
          "Could not save your cart. Turn off private browsing and try again.";
        return;
      }
      msg.appendChild(document.createTextNode("Added to cart. "));
      var link = document.createElement("a");
      link.href = "/shop/cart/";
      link.textContent = "View cart";
      msg.appendChild(link);
      msg.appendChild(document.createTextNode("."));
    }

    function handleAdd(form) {
      var fd = new FormData(form);
      var slug = String(fd.get("slug") || "");
      var size = String(fd.get("size") || "");
      var qty = Number(fd.get("qty") || 1);
      var ok = window.KtechCart.add(slug, size, qty);
      var btn = form.querySelector('button[type="submit"]');
      var msg = form.parentElement && form.parentElement.querySelector("[data-add-msg]");
      if (!ok) {
        showMsg(msg, false);
        return;
      }
      if (btn) {
        var prev = btn.textContent;
        btn.textContent = "Added ✓";
        window.setTimeout(function () {
          btn.textContent = prev;
        }, 1500);
      }
      showMsg(msg, true);
    }

    document.querySelectorAll("[data-add-form]").forEach(function (form) {
      form.addEventListener("submit", function (e) {
        e.preventDefault();
        ensureCart()
          .then(function () {
            handleAdd(form);
          })
          .catch(function () {
            var msg = form.parentElement && form.parentElement.querySelector("[data-add-msg]");
            showMsg(msg, false);
          });
      });
    });

    function refreshShopPill() {
      var pill = document.querySelector("[data-shop-cart-pill]");
      var countEl = document.querySelector("[data-shop-cart-count]");
      if (!pill || !countEl || !window.KtechCart) return;
      var n = window.KtechCart.count();
      countEl.textContent = String(n);
      pill.hidden = n < 1;
    }
    refreshShopPill();
    window.addEventListener("ktech-cart-change", refreshShopPill);
    window.addEventListener("storage", function (e) {
      if (e.key === "ktech_cart_v1") refreshShopPill();
    });
  })();
</script>
