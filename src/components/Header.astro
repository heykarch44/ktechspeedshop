---
import { nav, site } from "../data/site";

const path = Astro.url.pathname;
---

<header class="site-header">
  <a class="wordmark" href="/" aria-label={`${site.name} home`}>
    <strong>K-TECH</strong>
    <span>SPEEDSHOP</span>
  </a>
  <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="nav">Menu</button>
  <nav class="nav" id="nav">
    {
      nav.map((item) => (
        <a href={item.href} aria-current={path.startsWith(item.href) ? "page" : undefined}>
          {item.label}
        </a>
      ))
    }
    <a
      class="nav-cart"
      href="/shop/cart"
      aria-label="Cart"
      data-cart-link
    >
      Cart<span class="cart-badge" data-cart-badge hidden>0</span>
    </a>
    <a class="nav-cta" href="/contact">Build inquiry</a>
  </nav>
</header>

<script src="/js/ktech-cart.js" is:inline></script>
<script is:inline>
  (function () {
    function refreshCartBadge() {
      var badge = document.querySelector("[data-cart-badge]");
      if (!badge || !window.KtechCart) return;
      var n = window.KtechCart.count();
      badge.textContent = String(n);
      badge.hidden = n < 1;
    }
    refreshCartBadge();
    window.addEventListener("ktech-cart-change", refreshCartBadge);
    window.addEventListener("storage", function (e) {
      if (e.key === "ktech_cart_v1") refreshCartBadge();
    });
  })();
</script>
<script>
  const toggle = document.querySelector(".nav-toggle");
  const nav = document.querySelector("#nav");
  toggle?.addEventListener("click", () => {
    const open = nav?.classList.toggle("open");
    toggle.setAttribute("aria-expanded", open ? "true" : "false");
  });
</script>
