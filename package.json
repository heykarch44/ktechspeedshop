{
  "name": "ktechspeedshop",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "astro dev",
    "prebuild": "node shared/merch/scripts/sync-merch-core.mjs --check",
    "build": "astro build",
    "preview": "astro preview",
    "deploy": "astro build && wrangler pages deploy dist --project-name=ktechspeedshop",
    "test:merch": "npx tsx --test shared/merch/server/cart.test.ts shared/merch/server/stripe.test.ts shared/merch/server/webhook.test.ts",
    "typecheck:functions": "npx tsc --noEmit -p functions"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.4.2",
    "astro": "^5.13.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261128.1",
    "tsx": "^4.23.15",
    "wrangler": "^4.28.0"
  }
}
